EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Google and Apple must be enabled in Supabase Auth (no client visibility flags).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Public style URL; no API key is needed for OpenFreeMap.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional: set only after hosting the web app with SPA fallback for /join.
# Empty uses installed-app links (rendezwho://join?token=...).
EXPO_PUBLIC_JOIN_BASE_URL=

# Hosted support and deletion-request pages required before release.
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_DELETION_URL=
