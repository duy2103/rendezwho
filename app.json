{
  "expo": {
    "name": "Rendezwho",
    "slug": "rendezwho-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.duyvu2103.rendezwhoapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.duyvu2103.rendezwhoapp"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Rendezwho to center the map on your location. Your precise location is not shared."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "rendezwho",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e4bf8b5-1af0-448a-b90f-89705fcec3fa"
      }
    },
    "icon": "./assets/brand/app-icon.png"
  }
}
